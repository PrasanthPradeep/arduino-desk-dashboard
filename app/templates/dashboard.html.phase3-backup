<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Arduino Desk Dashboard</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;
            background: #0b0f14;
            color: #e8edf3;
        }

        .container {
            max-width: 1500px;
            margin: auto;
            padding: 28px;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 28px;
            gap: 20px;
        }

        .title h1 {
            margin: 0;
            font-size: 28px;
        }

        .title p {
            margin: 6px 0 0;
            color: #8b96a5;
            font-size: 14px;
        }

        .refresh-info {
            color: #8b96a5;
            font-size: 13px;
            text-align: right;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 16px;
        }

        .card {
            background: #111720;
            border: 1px solid #202936;
            border-radius: 14px;
            padding: 20px;
        }

        .card-title {
            color: #8b96a5;
            font-size: 13px;
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: .06em;
        }

        .big-value {
            font-size: 30px;
            font-weight: 600;
        }

        .unit {
            font-size: 14px;
            color: #8b96a5;
            margin-left: 3px;
        }

        .progress {
            height: 7px;
            background: #202936;
            border-radius: 20px;
            overflow: hidden;
            margin-top: 14px;
        }

        .progress-bar {
            height: 100%;
            width: 0%;
            background: #55a6ff;
            transition: width .4s ease;
        }

        .storage-summary {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-top: 12px;
        }

        .storage-summary div {
            background: #0b1017;
            border-radius: 8px;
            padding: 8px;
        }

        .storage-summary span {
            display: block;
            color: #788493;
            font-size: 10px;
            margin-bottom: 3px;
        }

        .storage-summary strong {
            color: #cbd5e1;
            font-size: 12px;
            font-weight: 500;
        }

        .section {
            margin-top: 24px;
        }

        .section h2 {
            font-size: 18px;
            margin: 0 0 12px;
        }

        .drive-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .drive {
            position: relative;
        }

        .drive-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 10px;
        }

        .drive-name {
            font-size: 18px;
            font-weight: 600;
        }

        .drive-model {
            color: #8b96a5;
            font-size: 13px;
            margin-top: 4px;
        }

        .drive-capacity {
            margin-top: 6px;
            color: #788493;
            font-size: 11px;
        }

        .drive-capacity strong {
            color: #aab4c0;
            font-weight: 500;
        }

        .drive-storage {
            margin-top: 18px;
            padding: 14px;
            background: #0b1017;
            border-radius: 10px;
        }

        .drive-storage-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #aab4c0;
            font-size: 12px;
        }

        .drive-storage-header strong {
            color: #e8edf3;
            font-size: 14px;
        }

        .drive-storage .progress {
            margin-top: 10px;
        }

        .drive-storage-details {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            margin-top: 10px;
            color: #788493;
            font-size: 11px;
            flex-wrap: wrap;
        }

        .drive-storage-details strong {
            color: #cbd5e1;
            font-weight: 500;
        }

        .badge {
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .badge-ok {
            background: rgba(52, 211, 153, .12);
            color: #34d399;
        }

        .badge-warning {
            background: rgba(251, 191, 36, .12);
            color: #fbbf24;
        }

        .badge-critical {
            background: rgba(248, 113, 113, .12);
            color: #f87171;
        }

        .badge-unknown {
            background: rgba(148, 163, 184, .12);
            color: #94a3b8;
        }

        .drive-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-top: 20px;
        }

        .stat {
            background: #0b1017;
            border-radius: 9px;
            padding: 12px;
        }

        .stat-label {
            color: #788493;
            font-size: 11px;
            margin-bottom: 5px;
        }

        .stat-value {
            font-size: 16px;
            font-weight: 600;
        }

        .reasons {
            margin-top: 16px;
            padding: 12px;
            border-radius: 9px;
            background: #0b1017;
            font-size: 13px;
            color: #b8c1cc;
        }

        .network-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .network-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            background: #0b1017;
            border-radius: 10px;
        }

        .network-label {
            color: #aab4c0;
        }

        .online {
            color: #34d399;
        }

        .offline {
            color: #f87171;
        }

        .arduino-status {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .status-dot {
            width: 11px;
            height: 11px;
            border-radius: 50%;
            background: #64748b;
        }

        .status-dot.active {
            background: #34d399;
            box-shadow: 0 0 12px rgba(52, 211, 153, .5);
        }

        .footer {
            margin-top: 30px;
            text-align: center;
            color: #566170;
            font-size: 12px;
        }

        @media (max-width: 1000px) {
            .grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .drive-grid,
            .network-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 600px) {
            .container {
                padding: 16px;
            }

            .grid {
                grid-template-columns: 1fr;
            }

            .drive-stats {
                grid-template-columns: repeat(2, 1fr);
            }

            .storage-summary {
                grid-template-columns: 1fr;
            }

            header {
                flex-direction: column;
                align-items: flex-start;
            }

            .refresh-info {
                text-align: left;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <header>
        <div class="title">
            <h1>Arduino Desk Dashboard</h1>
            <p>Home server monitoring & Arduino control</p>
        </div>

        <div class="refresh-info">
            Auto refresh: 5 seconds<br>
            <span id="last-update">Waiting for data...</span>
        </div>
    </header>


    <!-- =========================================================
         SYSTEM
         ========================================================= -->

    <div class="grid">

        <!-- CPU -->
        <div class="card">
            <div class="card-title">CPU Usage</div>

            <div>
                <span class="big-value" id="cpu-usage">--</span>
                <span class="unit">%</span>
            </div>

            <div class="progress">
                <div class="progress-bar" id="cpu-bar"></div>
            </div>
        </div>


        <!-- CPU TEMPERATURE -->
        <div class="card">
            <div class="card-title">CPU Temperature</div>

            <div>
                <span class="big-value" id="cpu-temp">--</span>
                <span class="unit">°C</span>
            </div>
        </div>


        <!-- RAM -->
        <div class="card">
            <div class="card-title">RAM Usage</div>

            <div>
                <span class="big-value" id="ram-usage">--</span>
                <span class="unit">%</span>
            </div>

            <div class="progress">
                <div class="progress-bar" id="ram-bar"></div>
            </div>

            <div style="margin-top:8px;color:#788493;font-size:12px;">
                <span id="ram-used">--</span> /
                <span id="ram-total">--</span> GB
            </div>
        </div>


        <!-- STORAGE -->
        <div class="card">
            <div class="card-title">Storage</div>

            <div>
                <span class="big-value" id="storage-usage">--</span>
                <span class="unit">%</span>
            </div>

            <div class="progress">
                <div class="progress-bar" id="storage-bar"></div>
            </div>

            <div class="storage-summary">

                <div>
                    <span>Used</span>
                    <strong id="storage-used">--</strong>
                </div>

                <div>
                    <span>Free</span>
                    <strong id="storage-free">--</strong>
                </div>

                <div>
                    <span>Total</span>
                    <strong id="storage-total">--</strong>
                </div>

            </div>
        </div>

    </div>


    <!-- =========================================================
         STORAGE DRIVES
         ========================================================= -->

    <div class="section">

        <h2>Storage Drives</h2>

        <div class="drive-grid">


            <!-- =================================================
                 SDA
                 ================================================= -->

            <div class="card drive" id="drive-sda">

                <div class="drive-header">

                    <div>

                        <div class="drive-name">
                            Storage Drive
                        </div>

                        <div class="drive-model" id="sda-model">
                            Loading...
                        </div>

                        <div class="drive-capacity">
                            Physical capacity:
                            <strong id="sda-capacity">--</strong>
                        </div>

                    </div>

                    <span
                        class="badge badge-unknown"
                        id="sda-badge"
                    >
                        UNKNOWN
                    </span>

                </div>


                <!-- SDA FILESYSTEM STORAGE -->

                <div class="drive-storage">

                    <div class="drive-storage-header">

                        <span>
                            Filesystem Storage
                        </span>

                        <strong id="sda-storage-usage">
                            --
                        </strong>

                    </div>

                    <div class="progress">
                        <div
                            class="progress-bar"
                            id="sda-storage-bar"
                        ></div>
                    </div>

                    <div class="drive-storage-details">

                        <span>
                            Used:
                            <strong id="sda-storage-used">
                                --
                            </strong>
                        </span>

                        <span>
                            Free:
                            <strong id="sda-storage-free">
                                --
                            </strong>
                        </span>

                        <span>
                            Total:
                            <strong id="sda-storage-total">
                                --
                            </strong>
                        </span>

                    </div>

                </div>


                <!-- SDA SMART STATS -->

                <div class="drive-stats">

                    <div class="stat">

                        <div class="stat-label">
                            Temperature
                        </div>

                        <div class="stat-value">
                            <span id="sda-temp">--</span>
                            °C
                        </div>

                    </div>


                    <div class="stat">

                        <div class="stat-label">
                            Pending
                        </div>

                        <div class="stat-value">
                            <span id="sda-pending">--</span>
                        </div>

                    </div>


                    <div class="stat">

                        <div class="stat-label">
                            Reallocated
                        </div>

                        <div class="stat-value">
                            <span id="sda-reallocated">--</span>
                        </div>

                    </div>


                    <div class="stat">

                        <div class="stat-label">
                            Uncorrectable
                        </div>

                        <div class="stat-value">
                            <span id="sda-uncorrectable">--</span>
                        </div>

                    </div>


                    <div class="stat">

                        <div class="stat-label">
                            CRC Errors
                        </div>

                        <div class="stat-value">
                            <span id="sda-crc">--</span>
                        </div>

                    </div>


                    <div class="stat">

                        <div class="stat-label">
                            Self-Test
                        </div>

                        <div class="stat-value">
                            <span id="sda-selftest">--</span>
                        </div>

                    </div>

                </div>


                <div class="reasons" id="sda-reasons">
                    SMART assessment loading...
                </div>

            </div>



            <!-- =================================================
                 SDB
                 ================================================= -->

            <div class="card drive" id="drive-sdb">

                <div class="drive-header">

                    <div>

                        <div class="drive-name">
                            System Drive
                        </div>

                        <div class="drive-model" id="sdb-model">
                            Loading...
                        </div>

                        <div class="drive-capacity">
                            Physical capacity:
                            <strong id="sdb-capacity">--</strong>
                        </div>

                    </div>

                    <span
                        class="badge badge-unknown"
                        id="sdb-badge"
                    >
                        UNKNOWN
                    </span>

                </div>


                <!-- SDB FILESYSTEM STORAGE -->

                <div class="drive-storage">

                    <div class="drive-storage-header">

                        <span>
                            Filesystem Storage
                        </span>

                        <strong id="sdb-storage-usage">
                            --
                        </strong>

                    </div>

                    <div class="progress">
                        <div
                            class="progress-bar"
                            id="sdb-storage-bar"
                        ></div>
                    </div>

                    <div class="drive-storage-details">

                        <span>
                            Used:
                            <strong id="sdb-storage-used">
                                --
                            </strong>
                        </span>

                        <span>
                            Free:
                            <strong id="sdb-storage-free">
                                --
                            </strong>
                        </span>

                        <span>
                            Total:
                            <strong id="sdb-storage-total">
                                --
                            </strong>
                        </span>

                    </div>

                </div>


                <!-- SDB SMART STATS -->

                <div class="drive-stats">

                    <div class="stat">

                        <div class="stat-label">
                            Temperature
                        </div>

                        <div class="stat-value">
                            <span id="sdb-temp">--</span>
                            °C
                        </div>

                    </div>


                    <div class="stat">

                        <div class="stat-label">
                            Pending
                        </div>

                        <div class="stat-value">
                            <span id="sdb-pending">--</span>
                        </div>

                    </div>


                    <div class="stat">

                        <div class="stat-label">
                            Reallocated
                        </div>

                        <div class="stat-value">
                            <span id="sdb-reallocated">--</span>
                        </div>

                    </div>


                    <div class="stat">

                        <div class="stat-label">
                            Uncorrectable
                        </div>

                        <div class="stat-value">
                            <span id="sdb-uncorrectable">--</span>
                        </div>

                    </div>


                    <div class="stat">

                        <div class="stat-label">
                            CRC Errors
                        </div>

                        <div class="stat-value">
                            <span id="sdb-crc">--</span>
                        </div>

                    </div>


                    <div class="stat">

                        <div class="stat-label">
                            Self-Test
                        </div>

                        <div class="stat-value">
                            <span id="sdb-selftest">--</span>
                        </div>

                    </div>

                </div>


                <div class="reasons" id="sdb-reasons">
                    SMART assessment loading...
                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         NETWORK
         ========================================================= -->

    <div class="section">

        <h2>Network</h2>

        <div class="network-grid">

            <div class="card network-item">

                <span class="network-label">
                    Internet
                </span>

                <span>
                    <strong id="internet-status">--</strong>
                    ·
                    <span id="internet-ping">--</span> ms
                </span>

            </div>


            <div class="card network-item">

                <span class="network-label">
                    Router
                </span>

                <span>
                    <strong id="router-status">--</strong>
                    ·
                    <span id="router-ping">--</span> ms
                </span>

            </div>

        </div>

    </div>


    <!-- =========================================================
         ARDUINO
         ========================================================= -->

    <div class="section">

        <h2>Arduino Desk</h2>

        <div class="card">

            <div class="arduino-status">

                <div
                    class="status-dot"
                    id="arduino-dot"
                ></div>

                <div>

                    <div
                        style="
                            font-size:16px;
                            font-weight:600;
                        "
                        id="arduino-status"
                    >
                        Checking...
                    </div>

                    <div
                        style="
                            color:#788493;
                            font-size:12px;
                            margin-top:3px;
                        "
                    >
                        Arduino Desk Display service
                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="footer">
        Arduino Desk Dashboard
    </div>

</div>


<script>

    /*
     * ============================================================
     * HELPERS
     * ============================================================
     */

    function setText(id, value) {
        const element = document.getElementById(id);

        if (element) {
            element.textContent = value;
        }
    }


    function setProgress(id, value) {
        const element = document.getElementById(id);

        if (!element) {
            return;
        }

        let percentage = Number(value);

        if (!Number.isFinite(percentage)) {
            percentage = 0;
        }

        percentage = Math.max(
            0,
            Math.min(100, percentage)
        );

        element.style.width = percentage + "%";
    }


    function formatGB(value) {

        if (
            value === null ||
            value === undefined ||
            !Number.isFinite(Number(value))
        ) {
            return "--";
        }

        const number = Number(value);

        if (number >= 1000) {
            return (
                (number / 1000).toFixed(2) +
                " TB"
            );
        }

        return number.toFixed(2) + " GB";
    }


    function formatGBExact(value) {

        if (
            value === null ||
            value === undefined ||
            !Number.isFinite(Number(value))
        ) {
            return "--";
        }

        return Number(value).toFixed(2) + " GB";
    }


    function setBadge(id, assessment) {

        const badge = document.getElementById(id);

        if (!badge) {
            return;
        }

        const level =
            assessment &&
            assessment.level
                ? assessment.level
                : "UNKNOWN";

        const label =
            assessment &&
            assessment.label
                ? assessment.label
                : "Unknown";

        badge.textContent =
            label.toUpperCase();

        badge.className =
            "badge badge-" +
            level.toLowerCase();

    }


    function setReasons(id, assessment) {

        const element =
            document.getElementById(id);

        if (!element) {
            return;
        }

        if (
            !assessment ||
            !Array.isArray(assessment.reasons) ||
            assessment.reasons.length === 0
        ) {
            element.textContent =
                "No SMART assessment warnings.";
            return;
        }

        element.textContent =
            assessment.reasons.join(" ");
    }


    function formatSelfTest(drive) {

        if (
            !drive ||
            !drive.self_test
        ) {
            return "--";
        }

        const test =
            drive.self_test.test;

        const status =
            drive.self_test.status;

        if (
            !status ||
            status === "UNKNOWN"
        ) {
            return "Unknown";
        }

        if (test) {
            return test + ": " + status;
        }

        return status;
    }


    /*
     * ============================================================
     * SYSTEM
     * ============================================================
     */

    function updateSystem(system) {

        if (!system) {
            return;
        }

        setText(
            "cpu-usage",
            system.cpu_usage !== null
                ? Number(system.cpu_usage).toFixed(1)
                : "--"
        );

        setProgress(
            "cpu-bar",
            system.cpu_usage
        );


        setText(
            "cpu-temp",
            system.cpu_temperature !== null
                ? Number(
                    system.cpu_temperature
                ).toFixed(1)
                : "--"
        );


        setText(
            "ram-usage",
            system.ram_usage !== null
                ? Number(system.ram_usage).toFixed(1)
                : "--"
        );

        setProgress(
            "ram-bar",
            system.ram_usage
        );


        setText(
            "ram-used",
            system.ram_used_gb !== null
                ? Number(
                    system.ram_used_gb
                ).toFixed(2)
                : "--"
        );

        setText(
            "ram-total",
            system.ram_total_gb !== null
                ? Number(
                    system.ram_total_gb
                ).toFixed(2)
                : "--"
        );


        /*
         * Overall storage.
         */

        setText(
            "storage-usage",
            system.storage_usage !== null
                ? Number(
                    system.storage_usage
                ).toFixed(1)
                : "--"
        );

        setProgress(
            "storage-bar",
            system.storage_usage
        );


        setText(
            "storage-used",
            formatGB(
                system.storage_used_gb
            )
        );

        setText(
            "storage-free",
            formatGB(
                system.storage_free_gb
            )
        );

        setText(
            "storage-total",
            formatGB(
                system.storage_total_gb
            )
        );
    }


    /*
     * ============================================================
     * DRIVE
     * ============================================================
     */

    function updateDrive(
        driveName,
        drive
    ) {

        if (!drive) {
            return;
        }


        /*
         * Model
         */

        setText(
            driveName + "-model",
            drive.model || "Unknown drive"
        );


        /*
         * Physical capacity
         */

        if (
            drive.capacity_gb !== null &&
            drive.capacity_gb !== undefined
        ) {

            setText(
                driveName + "-capacity",
                formatGB(
                    drive.capacity_gb
                )
            );

        } else {

            setText(
                driveName + "-capacity",
                drive.capacity || "--"
            );

        }


        /*
         * SMART assessment
         */

        setBadge(
            driveName + "-badge",
            drive.assessment
        );

        setReasons(
            driveName + "-reasons",
            drive.assessment
        );


        /*
         * Filesystem storage
         */

        const filesystem =
            drive.filesystem;

        if (filesystem) {

            setText(
                driveName +
                "-storage-usage",
                Number(
                    filesystem.usage_percent
                ).toFixed(1) + "%"
            );

            setProgress(
                driveName +
                "-storage-bar",
                filesystem.usage_percent
            );

            setText(
                driveName +
                "-storage-used",
                formatGBExact(
                    filesystem.used_gb
                )
            );

            setText(
                driveName +
                "-storage-free",
                formatGBExact(
                    filesystem.free_gb
                )
            );

            setText(
                driveName +
                "-storage-total",
                formatGBExact(
                    filesystem.total_gb
                )
            );

        } else {

            setText(
                driveName +
                "-storage-usage",
                "--"
            );

            setProgress(
                driveName +
                "-storage-bar",
                0
            );

            setText(
                driveName +
                "-storage-used",
                "--"
            );

            setText(
                driveName +
                "-storage-free",
                "--"
            );

            setText(
                driveName +
                "-storage-total",
                "--"
            );
        }


        /*
         * SMART attributes
         */

        setText(
            driveName + "-temp",
            drive.temperature !== null
                ? Number(
                    drive.temperature
                ).toFixed(0)
                : "--"
        );


        setText(
            driveName + "-pending",
            drive.pending !== null
                ? drive.pending
                : "--"
        );


        setText(
            driveName + "-reallocated",
            drive.reallocated !== null
                ? drive.reallocated
                : "--"
        );


        setText(
            driveName + "-uncorrectable",
            drive.offline_uncorrectable !== null
                ? drive.offline_uncorrectable
                : "--"
        );


        setText(
            driveName + "-crc",
            drive.crc_errors !== null
                ? drive.crc_errors
                : "--"
        );


        setText(
            driveName + "-selftest",
            formatSelfTest(drive)
        );

    }


    /*
     * ============================================================
     * NETWORK
     * ============================================================
     */

    function updateNetwork(network) {

        if (!network) {
            return;
        }


        setText(
            "internet-status",
            network.internet_status || "--"
        );

        setText(
            "internet-ping",
            network.internet_ping_ms !== null
                ? Number(
                    network.internet_ping_ms
                ).toFixed(1)
                : "--"
        );


        setText(
            "router-status",
            network.router_status || "--"
        );

        setText(
            "router-ping",
            network.router_ping_ms !== null
                ? Number(
                    network.router_ping_ms
                ).toFixed(1)
                : "--"
        );


        const internet =
            document.getElementById(
                "internet-status"
            );

        if (internet) {

            internet.className =
                network.internet_status === "ONLINE"
                    ? "online"
                    : "offline";
        }


        const router =
            document.getElementById(
                "router-status"
            );

        if (router) {

            router.className =
                network.router_status === "ONLINE"
                    ? "online"
                    : "offline";
        }

    }


    /*
     * ============================================================
     * ARDUINO
     * ============================================================
     */

    function updateArduino(arduino) {

        if (!arduino) {
            return;
        }

        const active =
            Boolean(arduino.active);

        setText(
            "arduino-status",
            active
                ? "Active"
                : "Inactive"
        );


        const dot =
            document.getElementById(
                "arduino-dot"
            );

        if (dot) {

            dot.className =
                active
                    ? "status-dot active"
                    : "status-dot";
        }

    }


    /*
     * ============================================================
     * DASHBOARD
     * ============================================================
     */

    async function updateDashboard() {

        try {

            const response =
                await fetch(
                    "/api/dashboard",
                    {
                        cache: "no-store"
                    }
                );

            if (!response.ok) {
                throw new Error(
                    "HTTP " +
                    response.status
                );
            }


            const data =
                await response.json();


            updateSystem(
                data.system
            );


            if (
                data.smart &&
                data.smart.drives
            ) {

                updateDrive(
                    "sda",
                    data.smart.drives.sda
                );

                updateDrive(
                    "sdb",
                    data.smart.drives.sdb
                );
            }


            updateNetwork(
                data.network
            );


            updateArduino(
                data.arduino
            );


            /*
             * Last update time
             */

            if (data.timestamp) {

                const date =
                    new Date(
                        data.timestamp * 1000
                    );

                setText(
                    "last-update",
                    "Last update: " +
                    date.toLocaleTimeString()
                );
            }

        } catch (error) {

            console.error(
                "Dashboard update failed:",
                error
            );

            setText(
                "last-update",
                "Connection error"
            );
        }

    }


    /*
     * Initial load.
     */

    updateDashboard();


    /*
     * Refresh every 5 seconds.
     */

    setInterval(
        updateDashboard,
        5000
    );

</script>

</body>
</html>
