<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Arduino Desk Dashboard</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;
            background: #0b0f14;
            color: #e8edf3;
        }

        .container {
            max-width: 1500px;
            margin: auto;
            padding: 28px;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 28px;
            gap: 20px;
        }

        .title h1 {
            margin: 0;
            font-size: 28px;
        }

        .title p {
            margin: 6px 0 0;
            color: #8b96a5;
            font-size: 14px;
        }

        .refresh-info {
            color: #8b96a5;
            font-size: 13px;
            text-align: right;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 16px;
        }

        .card {
            background: #111720;
            border: 1px solid #202936;
            border-radius: 14px;
            padding: 20px;
        }

        .card-title {
            color: #8b96a5;
            font-size: 13px;
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: .06em;
        }

        .big-value {
            font-size: 30px;
            font-weight: 600;
        }

        .unit {
            font-size: 14px;
            color: #8b96a5;
            margin-left: 3px;
        }

        .progress {
            height: 7px;
            background: #202936;
            border-radius: 20px;
            overflow: hidden;
            margin-top: 14px;
        }

        .progress-bar {
            height: 100%;
            width: 0%;
            background: #55a6ff;
            transition: width .4s ease;
        }

        .section {
            margin-top: 24px;
        }

        .section h2 {
            font-size: 18px;
            margin: 0 0 12px;
        }

        .drive-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .drive {
            position: relative;
        }

        .drive-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 10px;
        }

        .drive-name {
            font-size: 18px;
            font-weight: 600;
        }

        .drive-model {
            color: #8b96a5;
            font-size: 13px;
            margin-top: 4px;
        }

        .badge {
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .badge-ok {
            background: rgba(52, 211, 153, .12);
            color: #34d399;
        }

        .badge-warning {
            background: rgba(251, 191, 36, .12);
            color: #fbbf24;
        }

        .badge-critical {
            background: rgba(248, 113, 113, .12);
            color: #f87171;
        }

        .badge-unknown {
            background: rgba(148, 163, 184, .12);
            color: #94a3b8;
        }

        .drive-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-top: 20px;
        }

        .stat {
            background: #0b1017;
            border-radius: 9px;
            padding: 12px;
        }

        .stat-label {
            color: #788493;
            font-size: 11px;
            margin-bottom: 5px;
        }

        .stat-value {
            font-size: 16px;
            font-weight: 600;
        }

        .reasons {
            margin-top: 16px;
            padding: 12px;
            border-radius: 9px;
            background: #0b1017;
            font-size: 13px;
            color: #b8c1cc;
        }

        .network-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .network-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            background: #0b1017;
            border-radius: 10px;
        }

        .network-label {
            color: #aab4c0;
        }

        .online {
            color: #34d399;
        }

        .offline {
            color: #f87171;
        }

        .arduino-status {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .status-dot {
            width: 11px;
            height: 11px;
            border-radius: 50%;
            background: #64748b;
        }

        .status-dot.active {
            background: #34d399;
            box-shadow: 0 0 12px rgba(52, 211, 153, .5);
        }

        .footer {
            margin-top: 30px;
            text-align: center;
            color: #566170;
            font-size: 12px;
        }

        @media (max-width: 1000px) {
            .grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .drive-grid,
            .network-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 600px) {
            .container {
                padding: 16px;
            }

            .grid {
                grid-template-columns: 1fr;
            }

            .drive-stats {
                grid-template-columns: repeat(2, 1fr);
            }

            header {
                flex-direction: column;
                align-items: flex-start;
            }

            .refresh-info {
                text-align: left;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <header>
        <div class="title">
            <h1>Arduino Desk Dashboard</h1>
            <p>Home server monitoring & Arduino control</p>
        </div>

        <div class="refresh-info">
            Auto refresh: 5 seconds<br>
            <span id="last-update">Waiting for data...</span>
        </div>
    </header>


    <!-- SYSTEM -->
    <div class="grid">

        <div class="card">
            <div class="card-title">CPU Usage</div>
            <div>
                <span class="big-value" id="cpu-usage">--</span>
                <span class="unit">%</span>
            </div>

            <div class="progress">
                <div class="progress-bar" id="cpu-bar"></div>
            </div>
        </div>


        <div class="card">
            <div class="card-title">CPU Temperature</div>
            <div>
                <span class="big-value" id="cpu-temp">--</span>
                <span class="unit">°C</span>
            </div>
        </div>


        <div class="card">
            <div class="card-title">RAM Usage</div>
            <div>
                <span class="big-value" id="ram-usage">--</span>
                <span class="unit">%</span>
            </div>

            <div class="progress">
                <div class="progress-bar" id="ram-bar"></div>
            </div>

            <div style="margin-top:8px;color:#788493;font-size:12px;">
                <span id="ram-used">--</span> /
                <span id="ram-total">--</span> GB
            </div>
        </div>


        <div class="card">
            <div class="card-title">Storage</div>
            <div>
                <span class="big-value" id="storage-usage">--</span>
                <span class="unit">%</span>
            </div>

            <div class="progress">
                <div class="progress-bar" id="storage-bar"></div>
            </div>

            <div style="margin-top:8px;color:#788493;font-size:12px;">
                <span id="storage-used">--</span> /
                <span id="storage-total">--</span> GB
            </div>
        </div>

    </div>


    <!-- HDD -->
    <div class="section">
        <h2>Storage Drives</h2>

        <div class="drive-grid">

            <div class="card drive" id="drive-sda">
                <div class="drive-header">

                    <div>
                        <div class="drive-name">
                            Storage Drive
                        </div>

                        <div class="drive-model" id="sda-model">
                            Loading...
                        </div>
                    </div>

                    <span class="badge badge-unknown" id="sda-badge">
                        UNKNOWN
                    </span>

                </div>

                <div class="drive-stats">

                    <div class="stat">
                        <div class="stat-label">Temperature</div>
                        <div class="stat-value">
                            <span id="sda-temp">--</span> °C
                        </div>
                    </div>

                    <div class="stat">
                        <div class="stat-label">Pending</div>
                        <div class="stat-value" id="sda-pending">--</div>
                    </div>

                    <div class="stat">
                        <div class="stat-label">Reallocated</div>
                        <div class="stat-value" id="sda-reallocated">--</div>
                    </div>

                    <div class="stat">
                        <div class="stat-label">Uncorrectable</div>
                        <div class="stat-value" id="sda-uncorrectable">--</div>
                    </div>

                    <div class="stat">
                        <div class="stat-label">CRC Errors</div>
                        <div class="stat-value" id="sda-crc">--</div>
                    </div>

                    <div class="stat">
                        <div class="stat-label">Capacity</div>
                        <div class="stat-value" id="sda-capacity">--</div>
                    </div>

                </div>

                <div class="reasons" id="sda-reasons">
                    Loading SMART assessment...
                </div>
            </div>


            <div class="card drive" id="drive-sdb">

                <div class="drive-header">

                    <div>
                        <div class="drive-name">
                            System Drive
                        </div>

                        <div class="drive-model" id="sdb-model">
                            Loading...
                        </div>
                    </div>

                    <span class="badge badge-unknown" id="sdb-badge">
                        UNKNOWN
                    </span>

                </div>

                <div class="drive-stats">

                    <div class="stat">
                        <div class="stat-label">Temperature</div>
                        <div class="stat-value">
                            <span id="sdb-temp">--</span> °C
                        </div>
                    </div>

                    <div class="stat">
                        <div class="stat-label">Pending</div>
                        <div class="stat-value" id="sdb-pending">--</div>
                    </div>

                    <div class="stat">
                        <div class="stat-label">Reallocated</div>
                        <div class="stat-value" id="sdb-reallocated">--</div>
                    </div>

                    <div class="stat">
                        <div class="stat-label">Uncorrectable</div>
                        <div class="stat-value" id="sdb-uncorrectable">--</div>
                    </div>

                    <div class="stat">
                        <div class="stat-label">CRC Errors</div>
                        <div class="stat-value" id="sdb-crc">--</div>
                    </div>

                    <div class="stat">
                        <div class="stat-label">Capacity</div>
                        <div class="stat-value" id="sdb-capacity">--</div>
                    </div>

                </div>

                <div class="reasons" id="sdb-reasons">
                    Loading SMART assessment...
                </div>

            </div>

        </div>
    </div>


    <!-- NETWORK -->
    <div class="section">

        <h2>Network</h2>

        <div class="network-grid">

            <div class="card">

                <div class="network-item">
                    <span class="network-label">
                        Internet
                    </span>

                    <strong id="internet-status">
                        --
                    </strong>
                </div>

                <div class="network-item" style="margin-top:10px;">
                    <span class="network-label">
                        Ping
                    </span>

                    <strong>
                        <span id="internet-ping">--</span> ms
                    </strong>
                </div>

            </div>


            <div class="card">

                <div class="network-item">
                    <span class="network-label">
                        Router
                    </span>

                    <strong id="router-status">
                        --
                    </strong>
                </div>

                <div class="network-item" style="margin-top:10px;">
                    <span class="network-label">
                        Ping
                    </span>

                    <strong>
                        <span id="router-ping">--</span> ms
                    </strong>
                </div>

            </div>

        </div>

    </div>


    <!-- ARDUINO -->
    <div class="section">

        <h2>Arduino</h2>

        <div class="card">

            <div class="arduino-status">

                <div class="status-dot" id="arduino-dot"></div>

                <div>
                    <strong id="arduino-status">
                        Checking...
                    </strong>

                    <div style="color:#788493;font-size:13px;margin-top:4px;">
                        Arduino Desk service
                    </div>
                </div>

            </div>

        </div>

    </div>


    <div class="footer">
        Arduino Desk Dashboard · Home Server
    </div>

</div>


<script>

function setText(id, value) {
    const element = document.getElementById(id);

    if (element) {
        element.textContent = value ?? "--";
    }
}


function setProgress(id, value) {
    const element = document.getElementById(id);

    if (!element) {
        return;
    }

    const number = Number(value);

    element.style.width =
        Number.isFinite(number)
            ? Math.min(100, Math.max(0, number)) + "%"
            : "0%";
}


function setBadge(id, assessment) {

    const element = document.getElementById(id);

    if (!element || !assessment) {
        return;
    }

    element.textContent =
        assessment.label || "UNKNOWN";

    element.className = "badge";

    const level =
        String(assessment.level || "UNKNOWN").toLowerCase();

    if (level === "ok") {
        element.classList.add("badge-ok");
    }
    else if (level === "warning") {
        element.classList.add("badge-warning");
    }
    else if (level === "critical") {
        element.classList.add("badge-critical");
    }
    else {
        element.classList.add("badge-unknown");
    }
}


function updateDrive(name, drive) {

    if (!drive) {
        return;
    }

    setText(`${name}-model`, drive.model);

    setText(`${name}-temp`, drive.temperature);
    setText(`${name}-pending`, drive.pending);
    setText(`${name}-reallocated`, drive.reallocated);
    setText(`${name}-uncorrectable`, drive.offline_uncorrectable);
    setText(`${name}-crc`, drive.crc_errors);

    let capacity = "--";

    if (drive.capacity_gb !== null &&
        drive.capacity_gb !== undefined) {

        capacity =
            drive.capacity_gb >= 1000
                ? (drive.capacity_gb / 1000).toFixed(2) + " TB"
                : drive.capacity_gb.toFixed(1) + " GB";
    }

    setText(`${name}-capacity`, capacity);

    setBadge(
        `${name}-badge`,
        drive.assessment
    );

    const reasons =
        drive.assessment?.reasons || [];

    setText(
        `${name}-reasons`,
        reasons.length
            ? reasons.join(" ")
            : "No recorded SMART warnings."
    );
}


function updateNetwork(network) {

    setText(
        "internet-status",
        network.internet_status
    );

    setText(
        "router-status",
        network.router_status
    );

    setText(
        "internet-ping",
        network.internet_ping_ms
    );

    setText(
        "router-ping",
        network.router_ping_ms
    );

    const internet =
        document.getElementById("internet-status");

    const router =
        document.getElementById("router-status");

    internet.className =
        network.internet_status === "ONLINE"
            ? "online"
            : "offline";

    router.className =
        network.router_status === "ONLINE"
            ? "online"
            : "offline";
}


function updateArduino(arduino) {

    const status =
        arduino.active ? "ACTIVE" : "INACTIVE";

    setText(
        "arduino-status",
        status
    );

    const dot =
        document.getElementById("arduino-dot");

    dot.className =
        arduino.active
            ? "status-dot active"
            : "status-dot";
}


async function refreshDashboard() {

    try {

        const response =
            await fetch("/api/dashboard", {
                cache: "no-store"
            });

        if (!response.ok) {
            throw new Error(
                `HTTP ${response.status}`
            );
        }

        const data =
            await response.json();


        const system =
            data.system;

        setText(
            "cpu-usage",
            system.cpu_usage.toFixed(1)
        );

        setProgress(
            "cpu-bar",
            system.cpu_usage
        );


        setText(
            "cpu-temp",
            system.cpu_temperature
        );


        setText(
            "ram-usage",
            system.ram_usage.toFixed(1)
        );

        setProgress(
            "ram-bar",
            system.ram_usage
        );

        setText(
            "ram-used",
            system.ram_used_gb.toFixed(2)
        );

        setText(
            "ram-total",
            system.ram_total_gb.toFixed(2)
        );


        setText(
            "storage-usage",
            system.storage_usage.toFixed(1)
        );

        setProgress(
            "storage-bar",
            system.storage_usage
        );

        setText(
            "storage-used",
            system.storage_used_gb.toFixed(2)
        );

        setText(
            "storage-total",
            system.storage_total_gb.toFixed(2)
        );


        updateDrive(
            "sda",
            data.smart.drives.sda
        );

        updateDrive(
            "sdb",
            data.smart.drives.sdb
        );


        updateNetwork(
            data.network
        );


        updateArduino(
            data.arduino
        );


        const date =
            new Date(data.timestamp * 1000);

        setText(
            "last-update",
            "Updated " + date.toLocaleTimeString()
        );

    }
    catch (error) {

        console.error(
            "Dashboard refresh failed:",
            error
        );

        setText(
            "last-update",
            "Connection error"
        );
    }
}


refreshDashboard();

setInterval(
    refreshDashboard,
    5000
);

</script>

</body>
</html>
