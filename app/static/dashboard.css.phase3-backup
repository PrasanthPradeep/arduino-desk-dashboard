:root {
    --bg: #0b0f14;
    --surface: #111720;
    --surface-2: #161d27;
    --border: #26313e;

    --text: #f1f5f9;
    --muted: #8d9aaa;

    --blue: #4da3ff;
    --green: #31d17c;
    --yellow: #f5c451;
    --red: #ff5d68;

    --radius: 18px;
}


* {
    box-sizing: border-box;
}


body {
    margin: 0;

    background:
        radial-gradient(
            circle at top right,
            rgba(77, 163, 255, 0.08),
            transparent 30%
        ),
        var(--bg);

    color: var(--text);

    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
}


.app {
    min-height: 100vh;
}


/* HEADER */

.topbar {
    min-height: 86px;

    padding: 20px 32px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    border-bottom: 1px solid var(--border);

    background: rgba(11, 15, 20, 0.92);

    backdrop-filter: blur(12px);

    position: sticky;
    top: 0;
    z-index: 10;
}


.brand {
    font-size: 22px;
    font-weight: 750;
    letter-spacing: -0.5px;
}


.subtitle {
    margin-top: 3px;

    color: var(--muted);

    font-size: 13px;
}


.header-right {
    display: flex;
    align-items: center;
    gap: 18px;
}


.status-pill {
    padding: 7px 13px;

    border-radius: 999px;

    font-size: 12px;
    font-weight: 700;
}


.status-loading {
    background: var(--surface-2);
    color: var(--muted);
}


.status-good {
    background: rgba(49, 209, 124, 0.12);
    color: var(--green);
}


.status-warning {
    background: rgba(245, 196, 81, 0.12);
    color: var(--yellow);
}


.status-danger {
    background: rgba(255, 93, 104, 0.12);
    color: var(--red);
}


.last-update {
    color: var(--muted);
    font-size: 12px;
}


/* DASHBOARD */

.dashboard {
    max-width: 1250px;

    margin: 0 auto;

    padding: 34px 24px 60px;
}


.section {
    margin-bottom: 38px;
}


.section-title {
    margin-bottom: 15px;

    font-size: 15px;
    font-weight: 700;

    color: #cbd5e1;

    letter-spacing: 0.2px;
}


.section-heading-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
}


.section-info {
    color: var(--muted);
    font-size: 12px;
}


/* CARDS */

.card-grid {
    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 14px;
}


.card-grid.two {
    grid-template-columns:
        repeat(2, minmax(0, 1fr));
}


.card {
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,0.025),
            rgba(255,255,255,0.01)
        ),
        var(--surface);

    border: 1px solid var(--border);

    border-radius: var(--radius);

    box-shadow:
        0 8px 30px rgba(0,0,0,0.12);
}


.metric-card {
    padding: 21px;
}


.card-label {
    color: var(--muted);

    font-size: 12px;

    font-weight: 600;

    text-transform: uppercase;

    letter-spacing: 0.6px;
}


.metric-value {
    margin-top: 10px;

    font-size: 30px;

    font-weight: 750;

    letter-spacing: -1px;
}


.metric-sub {
    margin-top: 7px;

    color: var(--muted);

    font-size: 12px;
}


/* PROGRESS */

.progress {
    height: 5px;

    margin-top: 16px;

    overflow: hidden;

    background: #202934;

    border-radius: 99px;
}


.progress-fill {
    height: 100%;

    width: 0%;

    background: var(--blue);

    border-radius: inherit;

    transition: width 0.5s ease;
}


/* NETWORK */

.network-card {
    padding: 22px;

    display: flex;

    align-items: center;

    gap: 17px;
}


.network-icon {
    width: 43px;
    height: 43px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 13px;

    background: var(--surface-2);

    color: var(--muted);

    font-size: 16px;
}


.network-content {
    flex: 1;
}


.large-status {
    margin-top: 5px;

    font-size: 20px;

    font-weight: 700;
}


/* DRIVES */

.drive-grid {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 14px;
}


.drive-card {
    padding: 22px;
}


.drive-header {
    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 15px;
}


.drive-name {
    font-size: 19px;

    font-weight: 750;
}


.drive-device {
    margin-top: 4px;

    color: var(--muted);

    font-size: 12px;
}


.drive-badge {
    padding: 5px 10px;

    border-radius: 999px;

    font-size: 11px;

    font-weight: 750;
}


.badge-good {
    color: var(--green);
    background: rgba(49,209,124,0.1);
}


.badge-warning {
    color: var(--yellow);
    background: rgba(245,196,81,0.1);
}


.badge-danger {
    color: var(--red);
    background: rgba(255,93,104,0.1);
}


.drive-temp {
    margin-top: 25px;

    display: flex;

    align-items: baseline;

    gap: 7px;
}


.drive-temp-value {
    font-size: 30px;

    font-weight: 750;
}


.drive-temp-label {
    color: var(--muted);

    font-size: 12px;
}


.drive-stats {
    margin-top: 21px;

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 8px;
}


.drive-stat {
    padding: 11px;

    border-radius: 11px;

    background: var(--surface-2);
}


.drive-stat-label {
    color: var(--muted);

    font-size: 10px;

    text-transform: uppercase;

    letter-spacing: 0.4px;
}


.drive-stat-value {
    margin-top: 5px;

    font-size: 16px;

    font-weight: 700;
}


.drive-warning {
    margin-top: 18px;

    padding: 12px 13px;

    border-radius: 11px;

    background: rgba(255,93,104,0.07);

    border: 1px solid rgba(255,93,104,0.2);

    color: #ff9ca3;

    font-size: 12px;

    line-height: 1.5;
}


/* ARDUINO */

.arduino-card {
    padding: 22px;

    display: flex;

    align-items: center;

    gap: 17px;
}


.arduino-status-icon {
    width: 48px;
    height: 48px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 14px;

    background: rgba(77,163,255,0.1);

    font-size: 21px;
}


.arduino-content {
    flex: 1;
}


.arduino-actions {
    text-align: right;
}


.button {
    border: 0;

    padding: 10px 15px;

    border-radius: 10px;

    background: var(--blue);

    color: white;

    font-weight: 700;

    cursor: pointer;
}


.button.disabled {
    opacity: 0.4;

    cursor: not-allowed;
}


.coming-soon {
    margin-top: 6px;

    color: var(--muted);

    font-size: 10px;
}


/* FOOTER */

footer {
    display: flex;

    justify-content: space-between;

    color: #647181;

    font-size: 11px;

    padding-top: 15px;
}


/* LOADING */

.loading-card {
    padding: 30px;

    color: var(--muted);

    grid-column: 1 / -1;
}


/* MOBILE */

@media (max-width: 900px) {

    .card-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

}


@media (max-width: 650px) {

    .topbar {
        padding: 17px 18px;
    }

    .header-right {
        gap: 7px;
    }

    .last-update {
        display: none;
    }

    .dashboard {
        padding: 25px 15px 45px;
    }

    .card-grid,
    .card-grid.two,
    .drive-grid {
        grid-template-columns: 1fr;
    }

    .drive-stats {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .arduino-card {
        align-items: flex-start;

        flex-wrap: wrap;
    }

    .arduino-actions {
        width: 100%;

        text-align: left;
    }

    footer {
        flex-direction: column;
        gap: 6px;
    }

}
